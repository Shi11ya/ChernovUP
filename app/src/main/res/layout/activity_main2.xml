            android:id="@+id/show_more_text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Показать ещё"
            android:textSize="16sp"
            android:textColor="#2196F3"
            android:layout_marginBottom="8dp"/>

        <!-- Изображение поста -->
