<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD">

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#E3F2FD">

    <!-- Первый пост -->
    <LinearLayout
        android:id="@+id/post_layout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:elevation="2dp"
        android:padding="8dp"
        android:layout_marginBottom="16dp">

        <!-- Верхняя панель поста с аватаром, названием и кнопкой опций -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="30dp">

            <ImageButton
                android:id="@+id/avatar"
                android:layout_width="71dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/logo"
                android:contentDescription="TODO" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Название сообщества -->
                <TextView
                    android:id="@+id/author_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Новости. Борисоглебский техникум промышленных и информационных технологий"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="normal"/>

                <!-- Дата публикации -->
                <TextView
                    android:id="@+id/publication_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="19 марта в 13:36"
                    android:textSize="14sp"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Кнопка дополнительных опций -->
            <ImageButton
                android:id="@+id/more_options"
                android:layout_width="wrap_content"
                android:layout_height="47dp"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/points"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
        </LinearLayout>

        <!-- Текст поста -->
        <TextView
            android:id="@+id/post_description1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ЭСТАФЕТА ПАМЯТИ «ВО СЛАВУ ПОБЕДЫ!»
\n\n17 марта, активисты «Движения Первых», волонтеры
«Победы» и активисты ВПК «Соколы России» ГБПОУ ВО «БТПИТ»
совместно с советниками директора по воспитанию
и взаимодействию с детскими общественными объединениями
С.В. Алехиной и Е.В. Сахаровой."
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="0dp"/>

        <!-- Кнопка "Показать ещё" -->
